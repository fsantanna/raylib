;; Checks the driver of raylib.atm: the order of the events in a frame,
;; key and mouse events, time, polling, and drawing.

include "../../raylib.atm"

rl.window [title="env", width=200, height=100]

spawn {
    loop e on :rl.key.dn {
        print(rl.frame(), "key.dn", e.key, e.name)
    }
}
spawn {
    loop e on :rl.key.up {
        print(rl.frame(), "key.up", e.name, rl.key_down('RIGHT'))
    }
}
spawn {
    loop e on :rl.mouse.dn {
        print(rl.frame(), "mouse.dn", e.button, e.x, e.y)
    }
}
spawn {
    await 1s
    print(rl.frame(), "1s")
    await 500ms
    print(rl.frame(), "1.5s")
}
var x = 10
spawn {
    loop on :rl.frame {
        if rl.key_down(rl.KEY.RIGHT) {
            set x += 2
        }
    }
}
spawn {
    loop on :rl.draw {
        rl.clear(rl.RAYWHITE)
        rl.rectangle(x, 10, 20, 20, rl.RED)
        rl.text("env", 5, 80, 10, rl.BLACK)
    }
}
await :rl.quit
print(rl.frame(), "quit", x, rl.random(0,99), rl.random(0,99))
