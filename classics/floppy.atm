;; raylib - classic game: floppy
;;
;; Sample game developed by Ian Eito, Albert Martos and Ramon Santamaria.
;; Copyright (c) 2015 Ramon Santamaria (@raysan5), zlib license.
;;
;; Ported to Atmos: an altered version of `classics/src/floppy.c` of
;; raysan5/raylib-games. The game is the same; its control is written as
;; sequences: `gameOver`, `pause`, `superfx`, and `tubes[].active` of the C
;; became tasks, awaits, and a toggle.

include "../raylib.atm"
include "classic.atm"

val W, H   = 800, 450
val RADIUS = 24
val TUBE_W = 80
val NTUBES = 100

rl.window [title="classic game: floppy", width=W, height=H, fps=60]

val floppy = [x=0, y=0]         ;; where floppy is
var score  = 0
var hiscore = 0

;; A pair of tubes: moves left, ends the game when floppy touches it, and
;; scores once when floppy passes it. As in the C, in each frame the top tube
;; is checked before the bottom one, and the pairs in their order.
task Tube (game, x0, y) {
    var x = x0
    val ytop = y
    val ybot = (600 + y) - 255
    val func hit (yt) {
        rl.check_collision_circle_rec(floppy.x, floppy.y, RADIUS, x, yt, TUBE_W, 255)
    }
    par {
        ;; ahead of floppy, then behind it
        loop {
            await :rl.frame
            set x -= 2
            if hit(ytop) { emit @game :over }
            until x < floppy.x
            if hit(ybot) { emit @game :over }
        }
        emit @game :scored
        if hit(ybot) { emit @game :over }
        loop on :rl.frame {
            set x -= 2
            if hit(ytop) || hit(ybot) { emit @game :over }
        }
    } with {
        loop on :rl.draw {
            rl.rectangle(x, ytop, TUBE_W, 255, rl.GRAY)
            rl.rectangle(x, ybot, TUBE_W, 255, rl.GRAY)
        }
    }
}

;; One game: floppy, the tubes, and the score. Ends when floppy hits a tube.
task Play () {
    set floppy.x, floppy.y = 80, (H//2) - RADIUS
    set score = 0
    spawn {
        par {
            loop on :rl.frame {
                if rl.key_down('SPACE') {
                    set floppy.y -= 3
                } else {
                    set floppy.y += 1
                }
            }
        } with {
            loop on :rl.draw {
                rl.circle(floppy.x, floppy.y, RADIUS, rl.DARKGRAY)
            }
        }
    }
    pin tubes = tasks()
    loop i in NTUBES {
        spawn @tubes Tube(task, 400 + (280*i), -rl.random(0, 120))
    }
    spawn {
        ;; the flash: one frame of white when floppy scores
        loop {
            await :scored
            await :rl.draw
            rl.rectangle(0, 0, W, H, rl.WHITE)
        }
    }
    spawn {
        loop on :scored {
            set score += 100
            set hiscore = math.max(score, hiscore)
        }
    }
    spawn {
        loop on :rl.draw {
            rl.text(string.format("%04d", score), 20, 20, 40, rl.GRAY)
            rl.text(string.format("HI-SCORE: %04d", hiscore), 20, 70, 20, rl.LIGHTGRAY)
        }
    }
    await :over
}

;; [trace] of the test mode: one line per frame, after its logic
spawn {
    if rl.frame() > 0 {
        loop on :rl.draw {
            print(string.format("%d %s %.1f %d %d", rl.frame(), phase, floppy.y, score, hiscore))
        }
    }
}
;; [/trace]

await Classic(Play)
