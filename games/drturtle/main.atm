;; Dr. Turtle & Mr. GAMERA, by Ramon Santamaria (@raysan5), with Javier
;; Urios (art) and Pedro Fuentes (game design), credited in
;; README.original.md. Copyright (c) 2014 Ramon Santamaria (@raysan5), zlib
;; license. The art and sound are those of the original.
;;
;; Ported to Atmos: an altered version of `drturtle/src/06_drturtle_final.c`
;; of raysan5/raylib-games. The game is the same; its three screens (the
;; `currentScreen` of the C) are tasks in sequence, and the frame counter of
;; the C, which spawns an enemy every 41 frames and blinks the texts, is a
;; pair of awaits. The enemies keep the slots of the C: an enemy takes the
;; first free slot, and its rail is never that of the slot before it.

include "../../raylib.atm"

val W, H = 1280, 720
val N    = 10                           ;; MAX_ENEMIES
val f32  = rl.f32

rl.window [title="Dr. Turtle & Mr. GAMERA", width=W, height=H, fps=60]
rl.audio_init()

pin sky       = rl.texture("resources/sky.png")
pin mountains = rl.texture("resources/mountains.png")
pin sea       = rl.texture("resources/sea.png")
pin title     = rl.texture("resources/title.png")
pin turtle    = rl.texture("resources/turtle.png")
pin gamera    = rl.texture("resources/gamera.png")
val shark     = rl.texture("resources/shark.png")
val orca      = rl.texture("resources/orca.png")
val swhale    = rl.texture("resources/swhale.png")
val fish      = rl.texture("resources/fish.png")
pin gframe    = rl.texture("resources/gframe.png")
pin font      = rl.font("resources/komika.png")
pin eat       = rl.sound("resources/eat.wav")
pin die       = rl.sound("resources/die.wav")
pin growl     = rl.sound("resources/gamera.wav")
pin music     = rl.music("resources/speeding.ogg")
rl.play_music(music)

val SIZE    = rl.font_size(font)
val ENEMIES = [shark, orca, swhale, fish]   ;; by type: 3 is the fish
val POINTS  = [50, 150, 300]               ;; of the bad ones, by type

;; (int) of the C: towards zero
func int (x) {
    if x < 0 => math.ceil(x) => math.floor(x)
}

;; What all screens share: the scrolls, the blue of the sea, and the mode
;; (a flag: it changes in the middle of the loop over the enemies, and the
;; slots after it see it in that same frame).
var back, front = 0, 0                  ;; backScrolling, seaScrolling
var blue, time  = 200, 0
var gameraMode  = false
var hiscore, hidistance = 0, 0

;; the state of a game, for the screens and the trace
val game = [rail=1, score=0, distance=0, food=0, speed=10, enemies=[]]

;; Text that blinks: off for 30 frames, on for 30, and so on.
task Blink (s, x, y, spacing, c) {
    loop {
        await rl.Frames(30)
        watching rl.Frames(30) {
            loop on :rl.draw {
                rl.text_ex(font, s, x, y, SIZE, spacing, c)
            }
        }
    }
}

;; An enemy that leaves its slot: back to the right, inactive, of a new
;; type and on a new rail, never that of the slot before it.
func reset (i, type) {
    val e = game.enemies@i
    set e.active = false
    set e.type = type
    set e.rail = rl.random(0, 4)
    if i > 0 {
        loop {
            until e.rail != game.enemies@(i - 1).rail
            set e.rail = rl.random(0, 4)
        }
    }
    set e.x = W + 14
}

func rail_y (rail) {
    (rail * 120) + 90 + 14
}

task Title () {
    par :any {
        loop on :rl.frame {
            set front -= 2
            if front <= -W { set front = 0 }
        }
    } with {
        await :rl.frame until rl.key_pressed('ENTER')
    } with {
        spawn Blink("PRESS ENTER", (W//2) - 150, 480, 0, rl.WHITE)
        loop on :rl.draw {
            rl.draw_texture(title, (W//2) - (rl.texture_width(title)//2), (H//2) - (rl.texture_height(title)//2) - 80, rl.WHITE)
        }
    }
}

;; A game, from the frame of ENTER to the frame of the death.
task Gameplay () {
    set gameraMode = false
    val es = []
    set game.enemies = es
    loop i in N {
        val p = rl.random(0, 100)
        set es@i = []
        reset(i, if p < 30 => 0 => if p < 60 => 1 => if p < 90 => 2 => 3)
    }
    set game.rail, game.speed, game.score, game.distance, game.food = 1, 10, 0, 0, 0
    par :any {
        ;; an enemy every 41 frames, in the first free slot
        loop {
            await rl.Frames(41)
            var free = nil
            loop _,e in es {
                if !free && !e.active { set free = e }
            }
            if free { set free.active = true }
        }
    } with {
        var dead = false
        loop on :rl.frame {
            set back -= 1
            if back <= -W { set back = 0 }
            set front = int(f32(front - f32(game.speed - 2)))
            if front <= -W { set front = 0 }

            if rl.key_pressed('DOWN') {
                set game.rail += 1
            } else {
                if rl.key_pressed('UP') { set game.rail -= 1 }
            }
            set game.rail = math.max(0, math.min(4, game.rail))
            val py = rail_y(game.rail)

            loop i in N {
                val e = es@i
                if e.active { set e.x = f32(e.x - game.speed) }
                if e.x <= -128 { reset(i, rl.random(0, 3)) }
            }
            if !gameraMode { set game.speed = f32(game.speed + 0.005) }

            loop i in N {
                val e = es@i
                if e.active && rl.check_collision_recs(30 + 14, py, 100, 100, e.x, rail_y(e.rail), 100, 100) {
                    if e.type < 3 {             ;; the bad ones
                        if gameraMode {
                            set game.score += POINTS@(e.type)
                            set game.food += 15
                            reset(i, rl.random(0, 3))
                            rl.play_sound(eat)
                        } else {
                            rl.play_sound(die)
                            set dead = true
                            set hiscore = math.max(hiscore, game.score)
                            set hidistance = math.max(hidistance, game.distance)
                        }
                    } else {                    ;; a sweet fish
                        reset(i, rl.random(0, 3))
                        set game.food += if gameraMode => 25 => 80
                        set game.score += 10
                        if game.food == 400 {
                            set gameraMode = true
                            rl.play_sound(growl)
                        }
                        rl.play_sound(eat)
                    }
                }
            }

            if gameraMode {
                set game.food -= 1
                if game.food <= 0 {
                    set gameraMode = false
                    set game.speed = math.max(10, f32(game.speed - 2))
                }
            }
            set game.distance += 0.5
            until dead
        }
    } with {
        loop on :rl.draw {
            loop i in 5 {
                rl.rectangle(0, (i * 120) + 120, W, 110, rl.fade(rl.SKYBLUE, 0.1))
            }
            val py = rail_y(game.rail)
            if gameraMode {
                rl.draw_texture(gamera, 30 + 14 - 64, py - 64, rl.WHITE)
            } else {
                rl.draw_texture(turtle, 30, py - 14, rl.WHITE)
            }
            loop _,e in es {
                if e.active {
                    rl.draw_texture(ENEMIES@(e.type), f32(e.x - 14), rail_y(e.rail) - 14, rl.WHITE)
                }
            }
            rl.rectangle(20, 20, 400, 40, rl.fade(rl.GRAY, 0.4))
            rl.rectangle(20, 20, game.food, 40, rl.ORANGE)
            rl.rectangle_lines(20, 20, 400, 40, rl.BLACK)
            rl.text_ex(font, string.format("SCORE: %04d", game.score), W - 300, 20, SIZE, -2, rl.ORANGE)
            rl.text_ex(font, string.format("DISTANCE: %04d", int(game.distance)), 550, 20, SIZE, -2, rl.ORANGE)
            if gameraMode {
                rl.text("GAMERA MODE", 60, 22, 40, rl.GRAY)
                rl.draw_texture(gframe, 0, 0, rl.fade(rl.WHITE, 0.5))
            }
        }
    }
}

;; The end of a game, until ENTER.
task Ending () {
    par :any {
        await :rl.frame until rl.key_pressed('ENTER')
    } with {
        loop on :rl.draw {
            rl.rectangle(0, 0, W, H, rl.fade(rl.BLACK, 0.4))
            rl.text_ex(font, "GAME OVER", 300, 160, SIZE * 3, -2, rl.MAROON)
            rl.text_ex(font, string.format("SCORE: %04d", game.score), 680, 350, SIZE, -2, rl.GOLD)
            rl.text_ex(font, string.format("DISTANCE: %04d", int(game.distance)), 290, 350, SIZE, -2, rl.GOLD)
            rl.text_ex(font, string.format("HISCORE: %04d", hiscore), 665, 400, SIZE, -2, rl.ORANGE)
            rl.text_ex(font, string.format("HIDISTANCE: %04d", int(hidistance)), 270, 400, SIZE, -2, rl.ORANGE)
        }
    } with {
        await Blink("PRESS ENTER to REPLAY", (W//2) - 250, 520, -2, rl.LIGHTGRAY)
    }
}

;; The music, the blue of the sea, and the background of all screens.
spawn {
    par {
        loop on :rl.frame {
            rl.update_music(music)
            set blue = math.floor(f32(210 + f32(25 * rl.sinf(time))))
            set time = f32(time + 0.01)
        }
    } with {
        loop on :rl.draw {
            rl.clear(rl.RAYWHITE)
            rl.draw_texture(sky, 0, 0, rl.WHITE)
            rl.draw_texture(mountains, back, 0, rl.WHITE)
            rl.draw_texture(mountains, W + back, 0, rl.WHITE)
            val c = if gameraMode => 0xFF7142FF => (0x10BD00FF + (blue * 256))
            rl.draw_texture(sea, front, 0, c)
            rl.draw_texture(sea, W + front, 0, c)
        }
    }
}

var screen = 0                          ;; for the trace

;; [trace] of the test mode: one line per frame, after its logic
spawn {
    if rl.frame() > 0 {
        loop on :rl.draw {
            var s = string.format("%d %d %d %d %.1f %d %d %.4f %d %d %d", rl.frame(), screen, game.rail, game.score,
                game.distance, game.food, if gameraMode => 1 => 0, game.speed, front, back, blue)
            loop i in N {
                val e = game.enemies@i
                if e && e.active {
                    set s = s ++ string.format(" %d:%d:%d:%.4f", i, e.type, e.rail, e.x)
                }
            }
            print(s ++ string.format(" | %d %.1f", hiscore, hidistance))
        }
    }
}
;; [/trace]

await Title()
loop {
    set screen = 1
    await Gameplay()
    set screen = 2
    await Ending()
}
