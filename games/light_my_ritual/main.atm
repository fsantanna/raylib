;; Light my Ritual! (GGJ16), by Ramon Santamaria (@raysan5).
;; Copyright (c) 2016 Ramon Santamaria (@raysan5), zlib license. The art and
;; sound are those of the original, credited in README.original.md.
;;
;; Ported to Atmos: an altered version of `light_my_ritual/src/*.c` of
;; raysan5/raylib-games. The game is the same; the screens, the logo, the
;; blinking texts, the pause, the end of the ritual (by light or by time),
;; and the fade of the ritual are tasks and awaits. The lights and the
;; enemies keep the loops of the C, which couple them in each frame.

include "../../raylib.atm"
include "../screens.atm"

;; The lights of the three levels, from the colors of a map (red, green,
;; blue), as InitGameplayScreen: [[x,y], ...] for each level.
```:prelude
static AVal lmr_lights (void) {
    Image image = LoadImage("resources/lights_map.png");
    Color *map = LoadImageColors(image);
    AVal levels = a_tab();
    AVal ls[3] = { a_tab(), a_tab(), a_tab() };
    int k[3] = { 0, 0, 0 };
    for (int y = 0; y < image.height; y++) {
        for (int x = 0; x < image.width; x++) {
            Color c = map[y*image.width + x];
            int l = -1;
            if (c.r == 255 && c.g == 0 && c.b == 0 && c.a == 255) l = 0;
            else if (c.r == 0 && c.g == 255 && c.b == 0 && c.a == 255) l = 1;
            else if (c.r == 0 && c.g == 0 && c.b == 255 && c.a == 255) l = 2;
            if (l >= 0) {
                AVal p = a_tab();
                rl_set(p, "x", a_num((float)x*10));
                rl_set(p, "y", a_num((float)y*10));
                a_setindex(ls[l], a_int(k[l]++), p);
                a_dec(p);
            }
        }
    }
    for (int l = 0; l < 3; l++) { a_setindex(levels, a_int(l), ls[l]); a_dec(ls[l]); }
    UnloadImageColors(map);
    UnloadImage(image);
    return levels;
}
```

val W, H = 1280, 720
val f32  = rl.f32

rl.window [title="LIGHT MY RITUAL! [GGJ16]", width=W, height=H, fps=60]
rl.audio_init()
val MAP = `:value lmr_lights()`
pin font  = rl.font("resources/font_arcadian.png")
pin music = rl.music("resources/audio/ambient.ogg")
rl.play_music(music)
rl.music_volume(music, 1)
val FS = rl.font_size(font)

;; As in the C, never reset between games: the alpha of the title and the
;; light of the player.
var title_alpha = 0
var energy = 0

task LogoScreen () {
    pin l = spawn Logo(:title, nil)
    await :rl.frame until l.pub
    set pub = l.pub
    await false
}

task Title () {
    pin back  = rl.texture("resources/textures/back_title.png")
    pin title = rl.texture("resources/textures/title.png")
    pin start = rl.sound("resources/audio/start.wav")
    spawn {
        loop on :rl.draw {
            rl.rectangle(0, 0, W, H, rl.color(26, 26, 26, 255))
            rl.draw_texture(back, (W//2) - (rl.texture_width(back)//2), 0, rl.WHITE)
            rl.draw_texture(title, (W//2) - (rl.texture_width(title)//2), 30, rl.fade(rl.WHITE, title_alpha))
            rl.text("(c) Developed by Ramon Santamaria (@raysan5)", 20, H - 40, 20, rl.LIGHTGRAY)
        }
    }
    spawn {
        await rl.Frames(200)
        loop {
            watching rl.Frames(40) {
                loop on :rl.draw {
                    rl.text_ex(font, "PRESS ENTER to START LIGHTING", 230, 450, FS, -2, rl.WHITE)
                }
            }
            await rl.Frames(40)
        }
    }
    loop on :rl.frame {
        set title_alpha = math.min(f32(title_alpha + f32(0.005)), 1)
        until rl.key_pressed('ENTER') || rl.mouse_pressed(0)
    }
    rl.play_sound(start)
    rl.stop_music(music)
    set pub = :gameplay
    await false
}

var game = nil                          ;; for the trace

;; per level, the speed (in tenths) and the delay to awake of an enemy
val ENEMY = [[15,20,90,400], [10,20,240,800], [8,18,180,1200]]

task Gameplay () {
    val tex = func (n) { rl.texture("resources/textures/" ++ n ++ ".png") }
    pin background = tex("background")
    pin fore1, fore2, fore3 = tex("foreground_level_i"), tex("foreground_level_ii"), tex("foreground_level_iii")
    pin tplayer, tenemy, tlight = tex("player"), tex("enemy"), tex("light")
    pin glow, ray, book = tex("light_glow"), tex("light_ray"), tex("book")
    pin tritual, ttimeover = tex("msg_ritual"), tex("time_over")
    pin c1off, c2off, c3off = tex("circle_level_i_off"), tex("circle_level_ii_off"), tex("circle_level_iii_off")
    pin c1on, c2on, c3on = tex("circle_level_i_on"), tex("circle_level_ii_on"), tex("circle_level_iii_on")
    pin fxon  = rl.sound("resources/audio/light_on.wav")
    pin fxoff = rl.sound("resources/audio/light_off.wav")

    val p = [x=W//2, y=(H//2) - 40, color=rl.WHITE]
    ;; the lights of each level: position, radius, energy, on, animation
    val lights = []
    loop l,spec in [[12,3,9], [8,3,8], [8,4,10]] {
        val ls = []
        loop _,m in MAP@l {
            vector.insert(ls, [x=m.x, y=m.y, r=spec@0, on=false, counter=0, frame=0, rx=0])
        }
        loop _,lt in ls {
            set lt.energy = rl.random(spec@1, spec@2)
        }
        set lights@l = ls
    }
    var level = 0                       ;; 0, 1, 2; 3 when all are lit
    val enemies = []
    val reset = func (e) {
        set e.on, e.counter, e.r = false, 0, 10
        if rl.random(0, 1) == 1 {
            val x = rl.random(50, 150)
            val y = rl.random(50, H - 50)
            set e.x, e.y = x, y
        } else {
            val x = rl.random(W - 150, W - 50)
            val y = rl.random(50, H - 50)
            set e.x, e.y = x, y
        }
        if level < 3 {
            val spec = ENEMY@level
            set e.target = rl.random(0, #(lights@level) - 1)
            val t = lights@level@(e.target)
            set e.tx, e.ty = t.x, t.y
            set e.speed = f32(rl.random(spec@0, spec@1) / f32(10))
            set e.delay = rl.random(spec@2, spec@3)
        }
    }
    loop i in 8 {
        set enemies@i = []
        reset(enemies@i)
    }
    var total = 0
    loop _,ls in lights {
        loop _,lt in ls { set total += lt.energy }
    }
    var lit = 0                         ;; the energy of the lights on
    var frames = 0
    var ritual_time = 0
    val stars = rl.random(500, 1000)
    var stopped = false
    pin tmusic = rl.music("resources/audio/ritual.ogg")
    rl.play_music(tmusic)
    set game = [p=p, level=level]
    defer {
        set game = nil
    }

    ;; the game, until the lights are lit or the time is over
    pin play = spawn {
        loop on :rl.frame {
            set frames += 1
            ifs {
                rl.key_down('RIGHT') => { set p.x += 5 }
                rl.key_down('LEFT')  => { set p.x -= 5 }
            }
            ifs {
                rl.key_down('UP')   => { set p.y -= 5 }
                rl.key_down('DOWN') => { set p.y += 5 }
            }
            if rl.key_pressed('S') {
                set stopped = !stopped
            }
            if rl.check_collision_circles(p.x, p.y, 20, W//2, H//2, 50) {
                set energy = f32(energy + f32(0.2))
                set p.color = rl.color(255, 255, 100, 255)
            } else {
                set p.color = rl.WHITE
            }
            set energy = math.min(energy, 40)
            if level < 3 {
                loop _,lt in lights@level {
                    if rl.check_collision_circles(p.x, p.y, 20, lt.x, lt.y, lt.r) && !lt.on && (energy >= lt.energy) {
                        set lt.on = true
                        if level == 0 {
                            set lt.frame = 1
                        }
                        set energy = f32(energy - lt.energy)
                        rl.play_sound(fxon)
                    }
                }
            }
            loop _,ls in lights {
                loop _,lt in ls {
                    if lt.on {
                        set lt.counter += 1
                        if lt.counter > 10 {
                            set lt.frame += 1
                            if lt.frame > 6 { set lt.frame = 1 }
                            set lt.counter = 0
                        }
                    }
                    set lt.rx = (lt.frame*rl.texture_width(tlight)) // 7
                }
            }
            if !stopped {
                loop _,e in enemies {
                    if !e.on { set e.counter += 1 }
                    if e.counter > e.delay { set e.on = true }
                    if e.on {
                        var dx, dy = f32(e.tx - e.x), f32(e.ty - e.y)
                        var len = f32(math.sqrt(f32(f32(dx*dx) + f32(dy*dy))))
                        if len == 0 { set len = 1 }
                        val il = f32(1/len)
                        set dx, dy = f32(dx*il), f32(dy*il)
                        set e.x = f32(e.x + f32(dx*e.speed))
                        set e.y = f32(e.y + f32(dy*e.speed))
                        if level < 3 {
                            val lt = lights@level@(e.target)
                            if rl.check_collision_circles(e.x, e.y, e.r, e.tx, e.ty, lt.r) {
                                set lt.on, lt.counter, lt.frame, lt.rx = false, 0, 0, 0
                                reset(e)
                                rl.play_sound(fxoff)
                            }
                        }
                    }
                }
            }
            set lit = 0
            loop _,ls in lights {
                loop _,lt in ls {
                    if lt.on { set lit += lt.energy }
                }
            }
            val prev = level
            set level = 0
            var all = true
            loop l in 3 {
                loop _,lt in lights@l {
                    if !lt.on { set all = false }
                }
                if all { set level = l + 1 }
            }
            if level == 3 {
                loop _,e in enemies { set e.on = false }
            }
            if level != prev {
                loop _,e in enemies { reset(e) }
            }
            set game.level = level
            set ritual_time = f32(frames / f32(60))
            if f32(99 - ritual_time) <= 0 {
                set ritual_time = 99
                break :time
            }
            until level == 3, :lit
        }
    }
    ;; P pauses the game, at any time
    var paused = false
    spawn {
        loop {
            await :rl.key.dn [name='P']
            set paused = true
            toggle play(false)
            await :rl.key.dn [name='P']
            set paused = false
            toggle play(true)
        }
    }

    ;; the looks
    val center = func (t, y) { rl.draw_texture(t, (W//2) - (rl.texture_width(t)//2), y, rl.WHITE) }
    var ritual = nil                    ;; the alpha of the fade of the ritual
    var over = nil                      ;; :lit or :time, once the game is over
    spawn {
        loop on :rl.draw {
            rl.draw_texture(background, 0, 0, rl.WHITE)
            rl.draw_texture(if level >= 2 => fore3 => (if level == 1 => fore2 => fore1), 0, 0, rl.WHITE)
            val cy = func (t) { (H//2) - (rl.texture_height(t)//2) }
            match level {
                3 => { center(c3on, cy(c3on)) ; center(c2on, cy(c2on)) ; center(c1on, cy(c1on)) }
                2 => { center(c3off, cy(c3off)) ; center(c2on, cy(c2on)) ; center(c1on, cy(c1on)) }
                1 => { center(c2off, cy(c2off)) ; center(c1on, cy(c1on)) }
                0 => { center(c1off, cy(c1off)) }
            }
            loop k in (0, math.min(level, 2)) {
                val ls = lights@(math.min(level, 2) - k)
                loop _,lt in ls {
                    rl.draw_texture_rec(tlight, lt.rx, 0, 64, 64, lt.x - 32, lt.y - 32, rl.WHITE)
                }
                loop _,lt in ls {
                    if lt.on {
                        rl.draw_texture(glow, lt.x - (rl.texture_width(glow)//2), lt.y - (rl.texture_height(glow)//2), rl.fade(rl.WHITE, 0.3))
                    }
                }
                loop _,lt in ls {
                    rl.text(string.format("%02d", lt.energy), lt.x - 10, lt.y + 14, 20, if lt.on => rl.GRAY => rl.YELLOW)
                }
            }
            rl.draw_texture(book, (W//2) - (rl.texture_width(book)//2), H//2, rl.WHITE)
            rl.draw_texture(ray, (W//2) - (rl.texture_width(ray)//2), 0, rl.fade(rl.WHITE, 0.5))
            rl.draw_texture(tplayer, p.x - 32, p.y - 32, p.color)
            if level != 3 {
                loop _,e in enemies {
                    if e.on {
                        rl.draw_texture_rec(tenemy, 0, 0, 64, 64, e.x - 32, e.y - 32, rl.WHITE)
                    }
                }
                rl.text_ex(font, string.format("%02.2f", f32(99 - ritual_time)), 560, 20, FS, 0, rl.WHITE)
                rl.rectangle(20, 30, 400, 20, rl.GRAY)
                rl.rectangle(20, 30, f32(f32(400*energy) / 40), 20, rl.GOLD)
                rl.rectangle_lines(20, 30, 400, 20, rl.LIGHTGRAY)
                rl.text(string.format("%03.0f", energy), 430, 30, 20, rl.WHITE)
                rl.rectangle(W - 40, 30, 20, 660, rl.GRAY)
                rl.rectangle(W - 40, (30 + 660) - ((660*lit)//total), 20, (660*lit)//total, rl.YELLOW)
                rl.rectangle_lines(W - 40, 30, 20, 660, rl.LIGHTGRAY)
                if (energy < 2) && (((frames//20) % 2) == 1) {
                    rl.text_ex(font, "YOU'RE RUNNING OUT OF LIGHT!", 20, 60, FS//2, 0, rl.WHITE)
                }
            } else {
                if over != :time {
                    rl.rectangle(0, 0, W, H, rl.fade(rl.BLACK, 0.4))
                    center(tritual, 100)
                    rl.text_ex(font, string.format("BEST LIGHTING TIME: %02.2f", ritual_time), 320, 340, 50, 0, rl.WHITE)
                    rl.text_ex(font, "PRESS ENTER to START the RITUAL", 160, 480, 60, 0, rl.WHITE)
                    if rl.key_pressed('ENTER') && !ritual {
                        set ritual = 0
                    }
                }
            }
            if over == :time {
                rl.rectangle(0, 0, W, H, rl.fade(rl.BLACK, 0.4))
                center(ttimeover, 140)
                rl.text_ex(font, string.format("NEXT STARS ALIGNMENT IN %d YEARS", stars), 200, 360, 50, 0, rl.WHITE)
                rl.text_ex(font, "PRESS ENTER to GO HOME...", 260, 480, 60, 0, rl.WHITE)
                if rl.key_pressed('ENTER') {
                    set pub = :title
                }
            }
            if ritual {
                rl.rectangle(0, 0, W, H, rl.fade(rl.RAYWHITE, ritual))
            }
            if paused {
                rl.text_ex(font, "RITUAL PAUSED", (W//2) - (rl.measure("RITUAL PAUSED", 40)//2), 110, 50, 0, rl.WHITE)
            }
        }
    }
    ;; the fade of the ritual, after ENTER (which the C reads in the drawing)
    spawn {
        loop on :rl.frame {
            if ritual {
                set ritual = f32(ritual + f32(0.02))
                rl.music_volume(tmusic, f32(1 - ritual))
                if ritual > 1 {
                    set pub = [to=:logo, now=true]
                }
            }
        }
    }
    set over = await(play)
    await false
}

spawn {
    loop on :rl.draw {
        rl.clear(rl.RAYWHITE)
    }
}

;; [trace] of the test mode: one line per frame, after its logic
spawn {
    if rl.frame() > 0 {
        loop on :rl.draw {
            if game {
                print(string.format("%d %d %d %.6f %d", rl.frame(), game.p.x, game.p.y, energy, game.level))
            } else {
                print(string.format("%d", rl.frame()))
            }
        }
    }
}
;; [/trace]

val FADE = [
    color = rl.BLACK,
    inc = f32(0.05), into = \{ it >= 1 },
    dec = f32(0.05), back = \{ it <= 0 },
]
await Screens([logo=LogoScreen, title=Title, gameplay=Gameplay], :logo, FADE)
