;; What the games with screens share, as in their C: the logo of raylib,
;; and the screens with a transition between them.
;;
;; From raysan5/raylib-games (zlib license): the shared parts of its games.
;;
;;      include "../screens.atm"
;;      await Screens([logo=Logo, title=Title, ...], :logo)
;;
;; A screen is a task that updates in :rl.frame and draws in :rl.draw; when
;; it is done, it sets its `pub` to the name of the next screen, and goes on
;; being drawn while the screen fades to white. Then it is aborted (its
;; resources go with it), and the next screen starts, still under the white,
;; which fades in one frame (as the C does: `(int)transAlpha <= 0` holds as
;; soon as the alpha leaves 1). A new screen updates from the second frame
;; after it starts, as in the C.

;; The logo of raylib: a blinking corner, two bars, two bars, the letters,
;; "powered by", and a fade; then the screen `next`. `bars` is called when
;; the first bars start, and `written` 20 frames after the last letter.
task Logo (next, bars, written) {
    val x, y = (rl.width()//2) - 128, (rl.height()//2) - 128
    var top, left, bottom, right = 16, 16, 16, 16
    ;; the corner blinks: off in the frames 1..9, on in 10..19, and so on
    par :any {
        await rl.Frames(80)
    } with {
        await rl.Frames(10)
        loop {
            watching rl.Frames(10) {
                loop on :rl.draw {
                    rl.rectangle(x, y, 16, 16, rl.BLACK)
                }
            }
            await rl.Frames(10)
        }
    }
    if bars { bars() }
    ;; the top and left bars, then the bottom and right ones
    par :any {
        loop on :rl.frame {
            set top, left = top + 8, left + 8
            until top == 256
        }
    } with {
        loop on :rl.draw {
            rl.rectangle(x, y, top, 16, rl.BLACK)
            rl.rectangle(x, y, 16, left, rl.BLACK)
        }
    }
    par :any {
        loop on :rl.frame {
            set bottom, right = bottom + 8, right + 8
            until bottom == 256
        }
    } with {
        loop on :rl.draw {
            rl.rectangle(x, y, top, 16, rl.BLACK)
            rl.rectangle(x, y, 16, left, rl.BLACK)
            rl.rectangle(x + 240, y, 16, right, rl.BLACK)
            rl.rectangle(x, y + 240, bottom, 16, rl.BLACK)
        }
    }
    ;; the letters, one every 12 frames; "powered by" 21 frames after them;
    ;; the fade 201 frames after them
    var letters, alpha, powered = 0, 1, false
    par :any {
        loop _ in 10 {
            await rl.Frames(12)
            set letters += 1
        }
        par :any {
            await rl.Frames(20)
            if written { written() }
            await :rl.frame
            set powered = true
            await false
        } with {
            await rl.Frames(201)
            loop {
                set alpha = rl.f32(alpha - rl.f32(0.02))
                if alpha <= 0 {
                    set alpha = 0
                    set pub = next
                    await false
                }
                await :rl.frame
            }
        }
    } with {
        loop on :rl.draw {
            rl.rectangle(x, y, top, 16, rl.fade(rl.BLACK, alpha))
            rl.rectangle(x, y + 16, 16, left - 32, rl.fade(rl.BLACK, alpha))
            rl.rectangle(x + 240, y + 16, 16, right - 32, rl.fade(rl.BLACK, alpha))
            rl.rectangle(x, y + 240, bottom, 16, rl.fade(rl.BLACK, alpha))
            rl.rectangle((rl.width()//2) - 112, (rl.height()//2) - 112, 224, 224, rl.fade(rl.RAYWHITE, alpha))
            rl.text(rl.text_subtext("raylib", 0, letters), (rl.width()//2) - 44, (rl.height()//2) + 48, 50, rl.fade(rl.BLACK, alpha))
            if powered {
                rl.text("powered by", x, y - 27, 20, rl.fade(rl.DARKGRAY, alpha))
            }
        }
    }
}

;; The fades of the transitions, as the games do them: the color, the step
;; and the end of the fade in, the step and the end of the fade out.
val FADE_WHITE = [                      ;; wave_collector and others
    color = rl.RAYWHITE,
    inc = rl.f32(0.05), into = \{ math.floor(it) >= 1 },
    dec = rl.f32(0.05), back = \{ math.floor(it) <= 0 },  ;; (int)alpha: one frame
]
val FADE_BLACK = [                      ;; repair and others
    color = rl.BLACK,
    inc = rl.f32(0.05), into = \{ it > rl.f32(1.01) },
    dec = rl.f32(0.02), back = \{ it < rl.f32(-0.01) },
]

;; The screens, by name, from the first one, with a fade (FADE_WHITE by
;; default). Its `pub` tells, for a trace, the screen (`name`), whether a
;; transition is on (`trans`), and its alpha, as the C has them: the alpha
;; goes up to 1 exactly, at the change, and down to 0.
task Screens (screens, first, fade) {
    val f = if fade => fade => FADE_WHITE
    var name = first
    var fresh = false
    set pub = [name=first, trans=false, alpha=0]
    loop {
        set pub.name = name
        pin s = spawn (screens@name)()
        if fresh {
            ;; under the fade, which goes back; the screen is drawn, and
            ;; updates from the frame after the fade is gone
            toggle s(false) with :rl.draw
            var alpha = 1
            set pub.alpha = 1
            par :any {
                loop {
                    await :rl.frame
                    set alpha = rl.f32(alpha - f.dec)
                    set pub.alpha = alpha
                    until f.back(alpha)
                }
            } with {
                loop on :rl.draw {
                    rl.rectangle(0, 0, rl.width(), rl.height(), rl.fade(f.color, alpha))
                }
            }
            set pub.trans, pub.alpha = false, 0
            toggle s(true)
        }
        await :rl.frame until s.pub
        if s.pub ?? :table {
            ;; [to=, now=true]: the next screen at once, with no fade, as the
            ;; ChangeToScreen of the C; it updates from the next frame
            set name, fresh = s.pub.to, false
        } else {
        ;; the fade, over the screen, which is drawn but no more updated
        toggle s(false) with :rl.draw
        var alpha = 0
        set pub.trans = true
        spawn {
            loop on :rl.draw {
                rl.rectangle(0, 0, rl.width(), rl.height(), rl.fade(f.color, alpha))
            }
        }
        loop {
            await :rl.frame
            set alpha = rl.f32(alpha + f.inc)
            set pub.alpha = alpha
            until f.into(alpha)
        }
        set name, fresh = s.pub, true
        }
    }
}
